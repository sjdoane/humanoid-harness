  "findings": [
    {
      "finding_id": "fixed_gmt_motion_abi",
      "finding_type": "source_reported_fact",
      "title": "Fixed GMT reference ABI",
      "statement": "Pinned GMT code names 23 G1 joints, runs the controller at 50 Hz from a 1 ms simulation step with 20-step decimation, and reads fps, root_pos, root_rot in xyzw order, and dof_pos.",
      "source_ids": ["gmt_sim2sim", "gmt_motion_lib"],
      "locator": "Audit section Fixed GMT target",
      "not_evidence_for": ["external motion compatibility", "external motion trackability"]
    },
    {
      "finding_id": "motiondecode_bounded_measurement",
      "finding_type": "local_measurement",
      "title": "First-five MotionDecode low-height screen",
      "statement": "Under the favorable assumptions of root metres and 120 Hz, none of the first five pinned Low_Height_Walking CSVs reaches root_z <= 0.50; sample 00001 has the longest measured interval in the 0.30 to 0.60 band at 253 frames.",
      "source_ids": ["motiondecode_readme", "motiondecode_low_height_00001", "motiondecode_low_height_00002", "motiondecode_low_height_00003", "motiondecode_low_height_00004", "motiondecode_low_height_00005", "audit_document"],
      "locator": "Audit section Candidate 1 and its five-row table",
      "not_evidence_for": ["fitness of the other 30 public clips", "policy failure", "general admission rejection"]
    },
    {
      "finding_id": "motiondecode_metadata_blocker",
      "finding_type": "limitation",
      "title": "MotionDecode metadata and rights remain unresolved",
      "statement": "The CSV header and README disagree on root-position units, files lack per-file cadence, and the README-linked LICENSE is empty while a separate LICENSE.md states restricted terms. These contradictions block admission pending publisher resolution.",
      "source_ids": ["motiondecode_readme", "motiondecode_license_linked", "motiondecode_license_md", "audit_document"],
      "locator": "Audit section Candidate 1, Unresolved units and cadence and Rights/access blocker",
      "not_evidence_for": ["a legal conclusion", "permanent exclusion of MotionDecode"]
    },
    {
      "finding_id": "claw_crouch_shape",
      "finding_type": "local_measurement",
      "title": "CLAW 00454 is the closest measured low-gait shape",
      "statement": "At the publisher-reported 50 Hz, the pinned kinematic CSV has 216 consecutive 0.30 to 0.60 m band frames, 88 frames at or below 0.50 m, and measured local-forward-speed percentiles 0.490, 0.564, and 0.697 m/s. The dynamic CSV stays above 0.50 m and belongs to another controller/runtime.",
      "source_ids": ["claw_readme", "claw_00454_kinematic", "claw_00454_dynamic", "claw_00454_annotation", "audit_document"],
      "locator": "Audit section Candidate 2 and its measured data-property table",
      "not_evidence_for": ["GMT trackability", "contact feasibility", "admission", "policy success"]
    },
    {
      "finding_id": "claw_mapping_and_rights_limit",
      "finding_type": "limitation",
      "title": "CLAW requires rights resolution and GMT certification",
      "statement": "Pinned publisher files support a deterministic proposal to omit six named wrist joints and reorder the root quaternion, but matching fields does not prove embodiment or controller compatibility. No license was visible at the audited dataset or source-repository pins.",
      "source_ids": ["claw_g1_xml", "claw_render_script", "claw_source_readme", "audit_document"],
      "locator": "Audit section Candidate 2, Named mapping evidence through Disposition",
      "not_evidence_for": ["reuse permission", "GMT dynamics feasibility", "trackability"]
    },
    {
      "finding_id": "cmu_retargeting_route",
      "finding_type": "source_reported_fact",
      "title": "CMU supplies crouched human trials, not native G1 motion",
      "statement": "The observed CMU page labels Subject 136 trials 09 and 10 Walk Crouched at 120 Hz. Pinned GMR code documents an AMASS SMPL-X to 29-DoF G1 route at 30 Hz, but the route emits pickle and the audit did not establish these trials in AMASS SMPL-X.",
      "source_ids": ["cmu_subject_136_page", "cmu_136_asf", "cmu_136_09_amc", "cmu_136_10_amc", "gmr_readme", "gmr_conversion_script"],
      "locator": "Audit section Candidate 3",
      "not_evidence_for": ["native G1 compatibility", "completed retargeting", "GMT trackability"]
    },
    {
      "finding_id": "external_sources_not_admitted",
      "finding_type": "project_interpretation",
      "title": "No external reference is admitted",
      "statement": "Keep the eight native GMT clips for the current study. External admission remains a separate blocked capability requiring resolved rights and metadata, reviewed data-only conversion, numeric fitness reporting, and a separately authorized frozen-GMT dynamics probe.",
      "source_ids": ["audit_document", "motiondecode_license_md", "claw_source_readme", "cmu_terms", "gmr_license", "amass_license"],
      "locator": "Audit Decision boundary and Minimal external-admission gate",
      "not_evidence_for": ["policy success", "external source rejection in perpetuity", "a general root-height admission rule"]
    }
  ],
  "not_evidence_for": [
    "admission or certification of external motion",
    "GMT trackability or dynamics feasibility",
    "learned task success or policy evaluation",
    "a general requirement that references reach root_z <= 0.50"
  ]
}
